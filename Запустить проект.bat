@echo off
chcp 65001 >nul
cd /d "%~dp0"
title Платформа роботизации — запуск

echo ============================================
echo   Платформа подбора роботизации — запуск
echo ============================================
echo.

where docker >nul 2>nul
if errorlevel 1 (
    echo [!] На этом компьютере не найден Docker.
    echo.
    echo Что делать:
    echo   1. Скачайте и установите Docker Desktop:
    echo      https://www.docker.com/products/docker-desktop/
    echo   2. Перезагрузите компьютер.
    echo   3. Запустите Docker Desktop и дождитесь, пока он полностью загрузится.
    echo   4. Запустите этот файл ещё раз.
    echo.
    pause
    exit /b 1
)

docker info >nul 2>nul
if errorlevel 1 (
    echo [!] Docker Desktop установлен, но, похоже, не запущен.
    echo.
    echo Откройте приложение "Docker Desktop" ^(ищите в меню Пуск^),
    echo дождитесь, пока значок кита в панели задач перестанет мигать,
    echo и запустите этот файл ещё раз.
    echo.
    pause
    exit /b 1
)

echo Собираю и запускаю платформу.
echo При первом запуске это может занять 5-10 минут — скачиваются и
echo собираются программы. При следующих запусках будет намного быстрее.
echo.
echo Пожалуйста, не закрывайте это окно до конца загрузки.
echo.

docker compose up --build -d
if errorlevel 1 (
    echo.
    echo [!] Не получилось запустить платформу. Скопируйте весь текст
    echo     из этого окна и отправьте Стасу.
    echo.
    pause
    exit /b 1
)

echo.
echo Даю сервисам 15 секунд, чтобы полностью подняться...
timeout /t 15 >nul

echo Открываю платформу в браузере...
start http://localhost:5173

echo.
echo ============================================
echo   Готово! Платформа открылась в браузере.
echo.
echo   Это окно можно свернуть, но НЕ ЗАКРЫВАЙТЕ его —
echo   пока оно открыто (или свёрнуто), платформа работает.
echo.
echo   Чтобы остановить платформу — закройте это окно
echo   или запустите файл "Остановить проект.bat".
echo ============================================
echo.
pause
